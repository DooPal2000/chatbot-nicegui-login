# ==========================
# DATABASE CONFIG
# ==========================

# SQLite (개발용)
DATABASE_URL=sqlite:///./chatbot_test.db

# MSSQL (운영용, 필요시 주석 해제)
# DATABASE_URL=mssql+pyodbc://sa:your_password@localhost:1433/chatbot?driver=ODBC+Driver+17+for+SQL+Server

# ==========================
# MODEL CONFIG
# ==========================

# 사용할 모델 제공자: openai | local
MODEL_PROVIDER=openai

# 모델 이름 (OpenAI일 경우 gpt-4o-mini, gpt-4-turbo 등 / 로컬일 경우 gemma3-12b 등)
MODEL_NAME=gpt-4o-mini

# OpenAI API Key (MODEL_PROVIDER=openai일 때 필수)
OPENAI_API_KEY=sk-xxxxxx

# 로컬 모델 API 서버 URL (MODEL_PROVIDER=local일 때 필수)
# vLLM 기본: http://localhost:8000/v1
# Ollama 기본: http://localhost:11434/v1
LOCAL_MODEL_URL=http://localhost:8000/v1

# OPENAI_MODEL_TEMPERATURE
OPENAI_MODEL_TEMPERATURE=0.3

